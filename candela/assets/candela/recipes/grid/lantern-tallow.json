[
	{
		// Vanilla's eight lantern recipes (game:recipes/grid/lantern.json, 1.22.7)
		// with the beeswax candle swapped for a tallow one. The candle a lantern is
		// made with is the candle it starts out burning - see BlockCandelaLantern.
		//
		// Comments only inside a recipe, never between them: the loader may treat a
		// comment between array elements as a recipe of its own.
		ingredientPattern: "QCQ,NPN",
		ingredients: {
			"P": { type: "item", code: "game:metalplate-{metal}" },
			"N": { type: "item", code: "game:metalnailsandstrips-{metal}", quantity: 4 },
			"Q": { type: "item", code: "game:clearquartz", quantity: 2 },
			"C": { type: "item", code: "candela:candle-tallow" }
		},
		allowedVariants: {
			metal: ["copper", "brass", "blackbronze", "bismuth", "tinbronze", "bismuthbronze", "iron", "molybdochalkos", "silver", "gold", "meteoriciron", "steel", "electrum" ]
		},
		width: 3,
		height: 2,
		output: { 
			type: "block", 
			code: "game:lantern-large-up",
			attributes: {
				material: "{metal}",
				lining: "plain",
				glass: "quartz"
			}
		}
	},
