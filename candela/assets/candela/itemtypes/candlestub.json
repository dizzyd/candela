{
	code: "candlestub",
	class: "CandelaPlaceableCandle",
	variantgroups: [
		{ code: "material", states: ["beeswax", "tallow"] },
		{ code: "left", states: ["75", "50", "25"] }
	],
	// What is left of a new candle; the hours are that share of the wax's burn hours
	// in the config, so stubs follow it.
	attributesByType: {
		"*-beeswax-75": { candela: { wax: "beeswax", fraction: 0.75, bunch: "game:bunchocandles", single: "game:candle" } },
		"*-beeswax-50": { candela: { wax: "beeswax", fraction: 0.5,  bunch: "game:bunchocandles", single: "game:candle" } },
		"*-beeswax-25": { candela: { wax: "beeswax", fraction: 0.25, bunch: "game:bunchocandles", single: "game:candle" } },
		"*-tallow-75":  { candela: { wax: "tallow",  fraction: 0.75, bunch: "candela:tallowcandles", single: "candela:tallowcandle" } },
		"*-tallow-50":  { candela: { wax: "tallow",  fraction: 0.5,  bunch: "candela:tallowcandles", single: "candela:tallowcandle" } },
		"*-tallow-25":  { candela: { wax: "tallow",  fraction: 0.25, bunch: "candela:tallowcandles", single: "candela:tallowcandle" } }
	},
	// Placeholder: the whole candle, drawn smaller the less is left.
	shape: { base: "game:block/wax/candle3" },
	texturesByType: {
		"*-beeswax-*": { "candle": { base: "game:block/candle" } },
		"*-tallow-*": { "candle": { base: "candela:block/candle-tallow" } }
	},
	creativeinventory: { "general": ["*"], "items": ["*"] },
	maxstacksize: 32,
	combustibleProps: {
		burnTemperature: 500,
		burnDurationByType: { "*-75": 6, "*-50": 4, "*-25": 2 }
	},
	guiTransformByType: {
		"*-75": { origin: { x: 0.5, y: 0.2, z: 0.5 }, scale: 2.6 },
		"*-50": { origin: { x: 0.5, y: 0.2, z: 0.5 }, scale: 2.2 },
		"*-25": { origin: { x: 0.5, y: 0.2, z: 0.5 }, scale: 1.8 }
	}
}
