		origin: { x: 0.5, y: 0.8, z: 0.5 },
		scale: 0.7
	},
	groundTransform: {
		rotation: { x: 0, y: 0, z: 0 },
		origin: { x: 0.5, y: 0, z: 0.5 },
		scale: 2.5
	}
